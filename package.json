{
  "name": "big-online-store",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-service.mjs",
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "start:api": "node api-dist/server/index.js",
    "start:worker": "node api-dist/worker/index.js",
    "worker:once": "tsx worker/index.ts --once",
    "worker:import-csv": "tsx worker/import-csv.ts",
    "catalogue:import-public": "node scripts/import-public-retailer-catalogue.mjs",
    "catalogue:import-production": "node scripts/import-production-catalogue.mjs",
    "catalogue:publish-reviewed": "node scripts/publish-reviewed-products.mjs",
    "catalogue:reprice-product-margins": "tsx scripts/reprice-product-margins.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest run",
    "test": "vitest run",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "mysql2": "^3.15.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.15",
    "qs": "^6.16.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "cypress": "^16.1.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "description": "South African reseller storefront and operations MVP"
}
