# Frontend
VITE_API_URL=http://localhost:3001/api

# API / worker
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://root:password@localhost:3306/moya_market
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@moyamarket.co.za
ADMIN_PASSWORD=replace-before-first-deploy

# Pricing defaults (ZAR / percentages / hours)
MIN_EXPECTED_PROFIT=120
MIN_MARGIN_PERCENT=15
FREE_DELIVERY_THRESHOLD=999
SUPPLIER_STALE_HOURS=24
STANDARD_CUSTOMER_DELIVERY=89

# Optional permitted retailer feed. Do not add scraping-bypass credentials.
RETAILER_FEED_URL=
WORKER_CRON=0 3 * * *


# Public API URL used for webhook registration
PUBLIC_API_URL=

# Bob Go shipping (server-side only)
BOBGO_ENVIRONMENT=sandbox
BOBGO_API_KEY=
BOBGO_WEBHOOK_SECRET=
BOBGO_TIMEOUT_MS=15000
BOBGO_COLLECTION_COMPANY=Mzansi Mega Store
BOBGO_COLLECTION_CONTACT=
BOBGO_COLLECTION_PHONE=
BOBGO_COLLECTION_EMAIL=
BOBGO_COLLECTION_STREET=
BOBGO_COLLECTION_SUBURB=
BOBGO_COLLECTION_CITY=
BOBGO_COLLECTION_PROVINCE=Gauteng
BOBGO_COLLECTION_POSTAL_CODE=
# Safe fallback for catalogue products that do not yet have dimensions
BOBGO_DEFAULT_WEIGHT_KG=1
BOBGO_DEFAULT_LENGTH_CM=42
BOBGO_DEFAULT_WIDTH_CM=32
BOBGO_DEFAULT_HEIGHT_CM=6
