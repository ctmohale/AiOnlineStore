# Frontend
VITE_API_URL=http://localhost:3001/api

# API / worker
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://root:password@localhost:3306/moya_market
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@moyamarket.co.za
ADMIN_PASSWORD=replace-before-first-deploy

# Pricing defaults (ZAR / percentages / hours)
MIN_EXPECTED_PROFIT=120
MIN_MARGIN_PERCENT=15
FREE_DELIVERY_THRESHOLD=999
SUPPLIER_STALE_HOURS=24
STANDARD_CUSTOMER_DELIVERY=89

# Optional permitted retailer feed. Do not add scraping-bypass credentials.
RETAILER_FEED_URL=
WORKER_CRON=0 3 * * *
