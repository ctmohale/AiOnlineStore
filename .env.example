# Frontend
VITE_API_URL=http://localhost:3001/api

# API / worker
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
STORE_PUBLIC_URL=http://localhost:5173
DATABASE_URL=mysql://root:password@localhost:3306/moya_market
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@moyamarket.co.za
ADMIN_PASSWORD=replace-before-first-deploy

# Yoco Checkout API. Keep both values on the API service only; never expose them as VITE_ variables.
YOCO_SECRET_KEY=sk_test_replace-with-your-yoco-checkout-secret-key
YOCO_WEBHOOK_SECRET=whsec_replace-with-the-secret-returned-when-registering-the-webhook
# Optional override for local mocks; leave unset in production.
YOCO_API_URL=https://payments.yoco.com/api

# Transactional email. Configure these on the worker service; keep SMTP_PASS secret.
SMTP_HOST=cp75.domains.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@mzansimegastore.co.za
SMTP_PASS=replace-with-the-mailbox-password
EMAIL_FROM=Mzansi Mega Store <no-reply@mzansimegastore.co.za>
EMAIL_REPLY_TO=info@mzansimegastore.co.za
EMAIL_ADMIN=info@mzansimegastore.co.za
# Optional network timeouts in milliseconds.
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000

# Pricing defaults (ZAR / percentages / hours)
MIN_EXPECTED_PROFIT=120
MIN_MARGIN_PERCENT=15
FREE_DELIVERY_THRESHOLD=999
SUPPLIER_STALE_HOURS=24
STANDARD_CUSTOMER_DELIVERY=89

# Optional permitted retailer feed. Do not add scraping-bypass credentials.
RETAILER_FEED_URL=
WORKER_CRON=0 3 * * *
